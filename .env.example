# Telegram
BOT_TOKEN=                     # токен Telegram-бота от @BotFather (обязателен, читает gateway)

# AI backend — DeepSeek (основной провайдер) + GigaChat/Cloud.ru (запасной)
DEEPSEEK_API_KEY=
CLOUD_API_KEY=

# Master backend — квоты и админ-доступ
DAILY_READINGS_LIMIT=10        # раскладов на пользователя в сутки (0 — без лимита)
DAILY_LLM_LIMIT=30             # обращений к ИИ в сутки: расклады + уточнения
UNLIMITED_USER_IDS=            # Telegram ID без лимита, через запятую
ADMIN_USER_IDS=                # кому доступна команда /admin

# Postgres (db-backend + primary/replica)
POSTGRES_DB=tarotbot
POSTGRES_APP_USER=tarotbot
POSTGRES_APP_PASSWORD=tarotbot
POSTGRES_REPL_USER=replicator
POSTGRES_REPL_PASSWORD=replicator
